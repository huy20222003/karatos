# ==============================================
# Brain Agent Configuration
# ==============================================

# Database (Read-only access)
DATABASE_URL=postgresql://user:password@localhost:5432/nivasound

#Configuration Provider
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=your_ollma_base_url
OLLAMA_MODEL_NAME=your_ollma_model_name
MODEL_CONTEXT_SIZE=your_model_context_size
MODEL_THREADS=your_model_threads
MODEL_PARALLELISM=your_model_parallelism
OLLAMA_HEADERS=your_ollma_header

OPENAI_API_BASE=your_openai_api_base
OPENAI_MODEL_NAME=your_openai_model_name
OPENAI_API_KEY=your_openai_api_key

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL_NAME=your_anthropic_model_name

CLAUDE_WEB_MODEL_NAME=your_claude_web_model_name
CLAUDE_WEB_ENDPOINT=your_claude_web_endpoint
CLAUDE_WEB_TIMEOUT_SECONDS=120

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL_NAME=your_deepseek_model_name

#embedding 
OLLAMA_EMBEDDING_MODEL_NAME=your_ollama_embedding_model_name

#vision
OLLAMA_VISION_MODEL_NAME=your_ollama_vision_model_name

# Agent Behavior
SCAN_INTERVAL_MINUTES=10
ROLLING_WINDOW_HOURS=3
MAX_ACTIONS_PER_HOUR=20
HUMAN_APPROVAL_REQUIRED=false
MODEL_TEMPERATURE=0.4
MODEL_MAX_TOKENS=4096

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# MCP Configuration
MCP_CONFIG_PATH=config/mcp_servers.json

#Tavily AI 
TAVILY_API_KEY=your_tavily_api_key

# Memory Encryption (Auto-generated - DO NOT SHARE)
MEMORY_KEY=your_memory_key
SOCIAL_PULSE_ENABLED=true
SOCIAL_PULSE_CHANCE=0.1

#Context Limit
CONTEXT_GENERATION_LIMIT=100
CONTEXT_PLANNING_LIMIT=10
MAILBOX_AUTH_TOKEN=your_mailbox_auth_token

#Wisper model
WHISPER_MODEL_SIZE=small

# Resend Email Service
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_resend_from_email
