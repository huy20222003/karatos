# ==============================================
# Brain Agent Configuration
# ==============================================

# Database (Read-only access)
DATABASE_URL=postgresql://user:password@localhost:5432/nivasound

# LLM Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=nivacore
MODEL_CONTEXT_SIZE=8192
MODEL_THREADS=4
OLLAMA_HEADERS=your_ollma_header

# Agent Behavior
SCAN_INTERVAL_MINUTES=10
ROLLING_WINDOW_HOURS=3
MAX_ACTIONS_PER_HOUR=20
HUMAN_APPROVAL_REQUIRED=false
MODEL_TEMPERATURE=0.4
MODEL_MAX_TOKENS=4096

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# A2A Security (Neural Bridge Phase 2)
A2A_SECURITY_LEVEL=CONFIRM
ALLOWED_AGENTS=[]
A2A_BRIDGE_PORT=8090

# MCP Configuration
MCP_CONFIG_PATH=config/mcp_servers.json

#Tavily AI 
TAVILY_API_KEY=your_tavily_api_key

# Memory Encryption (Auto-generated - DO NOT SHARE)
MEMORY_KEY=your_memory_key
SOCIAL_PULSE_ENABLED=true

