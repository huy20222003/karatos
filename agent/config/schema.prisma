  blocked          MysticProfile @relation("BlockedByProfiles", fields: [blockedProfileId], references: [id], onDelete: Cascade)

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockerProfileId])
  @@index([blockedProfileId])
  @@map("mystic_blocks")
}

